# --- Source control (at least one required; both can be set) ---

# GitHub
GITHUB_TOKEN=ghp_xxxx
GITHUB_ORG=astral-sh

# GitLab (PAT needs read_api + read_repository; works on the free Hobby tier)
# GITLAB_TOKEN=glpat-xxxx
# GITLAB_GROUP=mygroup            # or mygroup/subgroup for a subgroup root

# --- App ---
SECRET_KEY=change-me
# For docker compose, DATABASE_URL is auto-set to the bundled postgres.
# For local dev against Supabase, paste the pooler connection string here:
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://epd:epd@db:5432/epd

# --- Data collection ---
BACKFILL_MONTHS=3
EXCLUDED_REPOS=
EXCLUDED_USERS=dependabot[bot],renovate[bot],github-actions[bot]
DEPLOYMENT_BRANCH=main
# DEPLOYMENT_TAG_PATTERN=v*.*.*
LARGE_PR_THRESHOLD=400

# --- Auth (optional; if unset, no login required) ---
# ADMIN_PASSWORD=

# --- App naming ---
APP_NAME=EPD
